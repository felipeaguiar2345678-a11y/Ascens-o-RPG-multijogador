FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
ENV HOME=/home/godot
ENV GODOT_SILENCE_ROOT_WARNING=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl unzip \
    libfontconfig1 libx11-6 libxcursor1 libxinerama1 libxrandr2 libxi6 \
    libxrender1 libasound2t64 libpulse0 libudev1 libdbus-1-3 \
    libwayland-client0 libdecor-0-0 \
    && rm -rf /var/lib/apt/lists/*

ARG GODOT_VERSION=4.7.2
ARG TARGETARCH
RUN set -eux; \
    case "${TARGETARCH}" in \
      amd64) GODOT_ARCH="x86_64" ;; \
      arm64) GODOT_ARCH="arm64" ;; \
      *) echo "Arquitetura Docker não suportada: ${TARGETARCH}" >&2; exit 1 ;; \
    esac; \
    curl -L --fail --retry 3 \
      "https://github.com/godotengine/godot/releases/download/${GODOT_VERSION}-stable/Godot_v${GODOT_VERSION}-stable_linux.${GODOT_ARCH}.zip" \
      -o /tmp/godot.zip; \
    unzip -q /tmp/godot.zip -d /opt/godot; \
    mv "/opt/godot/Godot_v${GODOT_VERSION}-stable_linux.${GODOT_ARCH}" /usr/local/bin/godot; \
    chmod +x /usr/local/bin/godot; \
    rm /tmp/godot.zip

RUN useradd --create-home --shell /usr/sbin/nologin godot
WORKDIR /app
COPY --chown=godot:godot godot/ /app/
USER godot

EXPOSE 2456/udp
VOLUME ["/home/godot/.local/share/godot/app_userdata/Ascensão do Soberano"]

ENTRYPOINT ["godot"]
CMD ["--headless", "--path", "/app", "res://scenes/servidor_dedicado.tscn"]
