; Projeto principal do Ascensão do Soberano
; Motor fixado em Godot 4.7.2 estável.
config_version=5

[application]
config/name="Ascensão do Soberano"
run/main_scene="res://scenes/conexao_multiplayer.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/description="RPG 2D exclusivamente online, em mundo multiplayer persistente."

[display]
window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[autoload]
RedeMultiplayer="*res://scripts/rede_multiplayer.gd"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/default_filters/texture_filter=1
environment/defaults/default_clear_color=Color(0.055, 0.075, 0.09, 1)
