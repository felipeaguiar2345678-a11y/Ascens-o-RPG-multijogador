# Chave Web do Firebase (identificador público do projeto; não use credenciais administrativas).
ASCENSAO_FIREBASE_API_KEY=

# Endpoint HTTPS do Cloudflare Worker publicado.
ASCENSAO_WORLD_STORAGE_URL=

# Segredo servidor-servidor igual a WORLD_STORAGE_TOKEN no Worker.
# Mantenha o valor real somente no .env local e no segredo do provedor.
ASCENSAO_WORLD_STORAGE_TOKEN=
