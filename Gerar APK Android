
name: Gerar APK Android

on:
  workflow_dispatch:
  push:
    branches:
      - main

jobs:
  build-apk:
    runs-on: ubuntu-latest

    steps:
      - name: Baixar projeto
        uses: actions/checkout@v4

      - name: Configurar Java
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - name: Configurar Gradle
        uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: '8.13'

      - name: Configurar Android SDK
        uses: android-actions/setup-android@v3

      - name: Extrair projeto
        run: |
          ZIP_FILE=$(find . -type f -name 'Ascensao_do_Soberano_Projeto_Android_MVP (2).zip' -print -quit)
          mkdir -p extracted
          unzip -q "$ZIP_FILE" -d extracted

      - name: Instalar Android SDK
        working-directory: extracted
        run: |
          SDK=$(grep -hE 'compileSdk[[:space:]]*=' app/build.gradle.kts | grep -oE '[0-9]+' | head -1)
          if [ -z "$SDK" ]; then
            SDK=$(grep -hE 'compileSdk\\(' app/build.gradle.kts | grep -oE '[0-9]+' | head -1)
          fi
          if [ -z "$SDK" ]; then
            echo "Não foi possível identificar o compileSdk"
            exit 1
          fi
          sdkmanager "platforms;android-$SDK" "platform-tools"

      - name: Compilar APK
        working-directory: extracted
        run: gradle assembleDebug

      - name: Disponibilizar APK
        uses: actions/upload-artifact@v4
        with:
          name: ascensao-do-soberano-apk
          path: extracted/app/build/outputs/apk/debug/app-debug.apk
          if-no-files-found: error
