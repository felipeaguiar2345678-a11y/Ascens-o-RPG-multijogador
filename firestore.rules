rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Dados particulares de cada jogador
    match /users/{uid} {
      allow read, create, update:
        if signedIn() && request.auth.uid == uid;
    }

    // Personagens e inventários
    match /characters/{characterId} {
      allow read:
        if signedIn() &&
        resource.data.ownerUid == request.auth.uid;

      allow create:
        if signedIn() &&
        request.resource.data.ownerUid == request.auth.uid;

      allow update:
        if signedIn() &&
        resource.data.ownerUid == request.auth.uid &&
        request.resource.data.ownerUid == request.auth.uid;

      allow delete:
        if signedIn() &&
        resource.data.ownerUid == request.auth.uid;
    }

    // Imagens e dados visuais privados de cada personagem.
    match /characterVisuals/{characterId} {
      allow read:
        if signedIn() &&
        resource.data.ownerUid == request.auth.uid;

      allow create:
        if signedIn() &&
        request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.characterId == characterId &&
        exists(/databases/$(database)/documents/characters/$(characterId)) &&
        get(/databases/$(database)/documents/characters/$(characterId)).data.ownerUid == request.auth.uid;

      allow update:
        if signedIn() &&
        resource.data.ownerUid == request.auth.uid &&
        request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.characterId == characterId &&
        exists(/databases/$(database)/documents/characters/$(characterId)) &&
        get(/databases/$(database)/documents/characters/$(characterId)).data.ownerUid == request.auth.uid;

      allow delete:
        if signedIn() &&
        resource.data.ownerUid == request.auth.uid;
    }

    // Campanhas multiplayer
    match /campaigns/{id} {
      allow read:
        if signedIn() &&
        request.auth.uid in resource.data.members;

      allow create:
        if signedIn() &&
        request.resource.data.ownerUid == request.auth.uid;

      allow update:
        if signedIn() &&
        request.auth.uid in resource.data.members;

      allow delete:
        if signedIn() &&
        resource.data.ownerUid == request.auth.uid;
    }

    // Catálogo global: qualquer jogador autenticado pode consultar.
    match /criaturas/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.id == id
        && request.resource.data.criadoPorUid == request.auth.uid
        && request.resource.data.nome is string
        && request.resource.data.nome.size() > 0
        && request.resource.data.ecosystemId is string
        && request.resource.data.ecosystemId.size() > 0;
      allow update, delete: if false;

      // Metadados das artes: somente o primeiro registrador pode criar.
      match /imagens/{imagemId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.criadoPorUid == request.auth.uid
          && request.resource.data.criaturaId == id
          && request.resource.data.imagemId == imagemId
          && exists(/databases/$(database)/documents/criaturas/$(id))
          && get(/databases/$(database)/documents/criaturas/$(id)).data.criadoPorUid == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // Bestiário individual — descobertas privadas de cada jogador
    match /jogadores/{uid}/bestiario/{criaturaId} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.criaturaId == criaturaId
        && exists(/databases/$(database)/documents/criaturas/$(criaturaId));
      allow update, delete: if false;
    }
  }
}
