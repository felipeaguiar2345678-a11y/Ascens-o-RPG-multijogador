rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Dados particulares de cada jogador
    match /users/{uid} {
      allow read, create, update:
        if signedIn() && request.auth.uid == uid;
    }

    // Personagens e inventários.
    // Estas regras validam identidade, formato e limites defensivos.
    // Elas NÃO tornam XP, ouro, itens ou combate autoritativos: isso exige
    // uma camada de servidor que ainda será implementada.
    match /characters/{characterId} {
      function validCharacterDocument(data) {
        return data.keys().hasOnly([
            'id', 'ownerUid', 'name', 'hasSeenIntro',
            'currentWorldPointId', 'respawnPointId', 'worldX', 'worldY',
            'level', 'xp', 'attributePoints', 'equipmentLoadout',
            'inventory', 'powerProfile', 'characterClass',
            'attributes', 'appearance'
          ])
          && data.keys().hasAll([
            'id', 'ownerUid', 'name', 'hasSeenIntro',
            'currentWorldPointId', 'respawnPointId', 'worldX', 'worldY',
            'level', 'xp', 'attributePoints', 'equipmentLoadout',
            'inventory', 'powerProfile', 'characterClass',
            'attributes', 'appearance'
          ])
          && data.id == characterId
          && data.ownerUid == request.auth.uid
          && data.name is string
          && data.name.size() > 0
          && data.name.size() <= 40
          && data.hasSeenIntro is bool
          && data.currentWorldPointId is string
          && data.currentWorldPointId.size() <= 100
          && data.respawnPointId is string
          && data.respawnPointId.size() <= 100
          && data.worldX is number
          && data.worldX >= -100
          && data.worldX <= 100
          && data.worldY is number
          && data.worldY >= -100
          && data.worldY <= 100
          && data.level is int
          && data.level >= 1
          && data.level <= 10000
          && data.xp is int
          && data.xp >= 0
          && data.xp <= 1000000000
          && data.attributePoints is int
          && data.attributePoints >= 0
          && data.attributePoints <= 100000
          && data.equipmentLoadout is map
          && data.inventory is map
          && data.inventory.keys().hasOnly(['items', 'eggs', 'companions', 'gold', 'equipment'])
          && data.inventory.keys().hasAll(['items', 'eggs', 'companions', 'gold', 'equipment'])
          && data.inventory.items is list
          && data.inventory.items.size() <= 500
          && data.inventory.eggs is list
          && data.inventory.eggs.size() <= 200
          && data.inventory.companions is list
          && data.inventory.companions.size() <= 100
          && data.inventory.equipment is list
          && data.inventory.equipment.size() <= 500
          && data.inventory.gold is int
          && data.inventory.gold >= 0
          && data.inventory.gold <= 1000000000000
          && data.powerProfile is map
          && data.powerProfile.keys().hasOnly(['desires', 'powers', 'observations'])
          && data.powerProfile.keys().hasAll(['desires', 'powers', 'observations'])
          && data.powerProfile.desires is list
          && data.powerProfile.desires.size() <= 100
          && data.powerProfile.powers is list
          && data.powerProfile.powers.size() <= 200
          && data.powerProfile.observations is list
          && data.powerProfile.observations.size() <= 500
          && data.characterClass is map
          && data.attributes is map
          && data.attributes.keys().hasOnly(['strength', 'intelligence', 'agility', 'vitality', 'spirit'])
          && data.attributes.keys().hasAll(['strength', 'intelligence', 'agility', 'vitality', 'spirit'])
          && data.attributes.strength is int
          && data.attributes.strength >= 0
          && data.attributes.strength <= 100000
          && data.attributes.intelligence is int
          && data.attributes.intelligence >= 0
          && data.attributes.intelligence <= 100000
          && data.attributes.agility is int
          && data.attributes.agility >= 0
          && data.attributes.agility <= 100000
          && data.attributes.vitality is int
          && data.attributes.vitality >= 0
          && data.attributes.vitality <= 100000
          && data.attributes.spirit is int
          && data.attributes.spirit >= 0
          && data.attributes.spirit <= 100000
          && data.appearance is map;
      }

      allow read:
        if signedIn() &&
        resource.data.ownerUid == request.auth.uid;

      allow create:
        if signedIn() &&
        validCharacterDocument(request.resource.data);

      allow update:
        if signedIn() &&
        resource.data.ownerUid == request.auth.uid &&
        request.resource.data.id == resource.data.id &&
        request.resource.data.ownerUid == resource.data.ownerUid &&
        validCharacterDocument(request.resource.data);

      allow delete:
        if signedIn() &&
        resource.data.ownerUid == request.auth.uid;
    }

    // Imagens e dados visuais privados de cada personagem.
    // O documento só pode ser criado/alterado se o personagem
    // correspondente existir e pertencer ao jogador autenticado.
    match /characterVisuals/{characterId} {
      allow read:
        if signedIn() &&
        resource.data.ownerUid == request.auth.uid;

      allow create:
        if signedIn() &&
        request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.characterId == characterId &&
        exists(/databases/$(database)/documents/characters/$(characterId)) &&
        get(/databases/$(database)/documents/characters/$(characterId)).data.ownerUid == request.auth.uid;

      allow update:
        if signedIn() &&
        resource.data.ownerUid == request.auth.uid &&
        request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.characterId == characterId &&
        exists(/databases/$(database)/documents/characters/$(characterId)) &&
        get(/databases/$(database)/documents/characters/$(characterId)).data.ownerUid == request.auth.uid;

      allow delete:
        if signedIn() &&
        resource.data.ownerUid == request.auth.uid;
    }

    // Convites são consultados diretamente pelo código; listagem é proibida.
    function invitePath(code) {
      return /databases/$(database)/documents/campaignInvites/$(code);
    }

    function joinProofPath(code, uid) {
      return /databases/$(database)/documents/campaignInvites/$(code)/joins/$(uid);
    }

    function validCampaignJoin(campaignId, code, uid) {
      return existsAfter(joinProofPath(code, uid))
        && getAfter(joinProofPath(code, uid)).data.userUid == uid
        && getAfter(joinProofPath(code, uid)).data.campaignId == campaignId
        && getAfter(joinProofPath(code, uid)).data.inviteCode == code
        && exists(invitePath(code))
        && get(invitePath(code)).data.active == true
        && get(invitePath(code)).data.campaignId == campaignId;
    }

    match /campaigns/{id} {
      allow get: if signedIn() && request.auth.uid in resource.data.members;
      allow list: if false;

      // A campanha e o convite precisam ser criados na mesma operação atômica.
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.members == [request.auth.uid]
        && request.resource.data.inviteCode is string
        && existsAfter(invitePath(request.resource.data.inviteCode))
        && getAfter(invitePath(request.resource.data.inviteCode)).data.campaignId == id
        && getAfter(invitePath(request.resource.data.inviteCode)).data.ownerUid == request.auth.uid
        && getAfter(invitePath(request.resource.data.inviteCode)).data.active == true;

      allow update: if signedIn() && (
        // O proprietário só pode editar nome e visibilidade.
        (resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'visibility']))
        ||
        // Um novo membro só pode ser adicionado com comprovante do convite.
        (request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.inviteCode == resource.data.inviteCode
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
          && resource.data.members is list
          && request.resource.data.members is list
          && request.resource.data.members.hasAll(resource.data.members)
          && request.resource.data.members.size() == resource.data.members.size() + 1
          && request.auth.uid in request.resource.data.members
          && validCampaignJoin(id, resource.data.inviteCode, request.auth.uid))
      );

      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    match /campaignInvites/{code} {
      allow get: if signedIn() && resource.data.active == true;
      allow list: if false;

      // O convite só pode nascer junto da campanha correspondente.
      allow create: if signedIn()
        && request.resource.data.inviteCode == code
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.active == true
        && request.resource.data.campaignId is string
        && existsAfter(/databases/$(database)/documents/campaigns/$(request.resource.data.campaignId))
        && getAfter(/databases/$(database)/documents/campaigns/$(request.resource.data.campaignId)).data.ownerUid == request.auth.uid
        && getAfter(/databases/$(database)/documents/campaigns/$(request.resource.data.campaignId)).data.inviteCode == code;

      allow update, delete: if false;

      match /joins/{uid} {
        allow read: if false;
        allow create: if signedIn()
          && request.auth.uid == uid
          && request.resource.data.userUid == uid
          && request.resource.data.inviteCode == code
          && request.resource.data.campaignId is string
          && exists(invitePath(code))
          && get(invitePath(code)).data.active == true
          && get(invitePath(code)).data.campaignId == request.resource.data.campaignId
          && exists(/databases/$(database)/documents/campaigns/$(request.resource.data.campaignId))
          && !(uid in get(/databases/$(database)/documents/campaigns/$(request.resource.data.campaignId)).data.members)
          && existsAfter(/databases/$(database)/documents/campaigns/$(request.resource.data.campaignId))
          && uid in getAfter(/databases/$(database)/documents/campaigns/$(request.resource.data.campaignId)).data.members;
        allow update, delete: if false;
      }
    }


    // Presença temporária dos jogadores no mundo.
    // Leitura para usuários autenticados; cada jogador só altera o próprio UID.
    match /worldPresence/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.keys().hasOnly([
          'uid', 'nome', 'nivel', 'worldPointId', 'x', 'y',
          'vida', 'vidaMaxima', 'ataque', 'defesa', 'mana', 'manaMaxima',
          'agilidade', 'poderMagico', 'imagemPersonagemUrl',
          'ultimaAtualizacao', 'online'
        ])
        && request.resource.data.nome is string
        && request.resource.data.nome.size() > 0
        && request.resource.data.nome.size() <= 40
        && request.resource.data.nivel is int
        && request.resource.data.nivel >= 1
        && request.resource.data.nivel <= 10000
        && request.resource.data.worldPointId is string
        && request.resource.data.worldPointId.size() > 0
        && request.resource.data.worldPointId.size() <= 100
        && request.resource.data.x is number
        && request.resource.data.x >= 0
        && request.resource.data.x <= 1
        && request.resource.data.y is number
        && request.resource.data.y >= 0
        && request.resource.data.y <= 1
        && request.resource.data.vida is int
        && request.resource.data.vida >= 0
        && request.resource.data.vidaMaxima is int
        && request.resource.data.vidaMaxima >= 1
        && request.resource.data.vidaMaxima <= 1000000
        && request.resource.data.vida <= request.resource.data.vidaMaxima
        && request.resource.data.ataque is int
        && request.resource.data.ataque >= 0
        && request.resource.data.ataque <= 1000000
        && request.resource.data.defesa is int
        && request.resource.data.defesa >= 0
        && request.resource.data.defesa <= 1000000
        && request.resource.data.mana is int
        && request.resource.data.mana >= 0
        && request.resource.data.manaMaxima is int
        && request.resource.data.manaMaxima >= 0
        && request.resource.data.manaMaxima <= 1000000
        && request.resource.data.mana <= request.resource.data.manaMaxima
        && request.resource.data.agilidade is int
        && request.resource.data.agilidade >= 0
        && request.resource.data.agilidade <= 1000000
        && request.resource.data.poderMagico is int
        && request.resource.data.poderMagico >= 0
        && request.resource.data.poderMagico <= 1000000
        && (!('imagemPersonagemUrl' in request.resource.data)
          || (request.resource.data.imagemPersonagemUrl is string
            && request.resource.data.imagemPersonagemUrl.size() <= 2048))
        && request.resource.data.ultimaAtualizacao is timestamp
        && request.resource.data.ultimaAtualizacao >= request.time - duration.value(2, 'm')
        && request.resource.data.ultimaAtualizacao <= request.time + duration.value(5, 's')
        && request.resource.data.online == true;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // Grupos cooperativos Ally (separados das campanhas).
    function allyGroupPath(groupId) {
      return /databases/$(database)/documents/allyGroups/$(groupId);
    }

    function allyInvitePath(inviteId) {
      return /databases/$(database)/documents/allyInvites/$(inviteId);
    }

    function allyMembershipPath(uid) {
      return /databases/$(database)/documents/allyMembership/$(uid);
    }

    function allyBattlePath(battleId) {
      return /databases/$(database)/documents/allyBattles/$(battleId);
    }

    // Estado narrativo compartilhado: leitura para integrantes; somente o líder avança a cena.
    match /allyStories/{groupId} {
      allow get: if signedIn()
        && exists(/databases/$(database)/documents/allyGroups/$(groupId))
        && request.auth.uid in get(/databases/$(database)/documents/allyGroups/$(groupId)).data.members;
      allow list: if false;
      allow create, update: if signedIn()
        && exists(/databases/$(database)/documents/allyGroups/$(groupId))
        && get(/databases/$(database)/documents/allyGroups/$(groupId)).data.leaderUid == request.auth.uid
        && request.resource.data.groupId == groupId
        && request.resource.data.updatedByUid == request.auth.uid
        && request.resource.data.chapterTitle is string
        && request.resource.data.chapterTitle.size() > 0
        && request.resource.data.chapterTitle.size() <= 120
        && request.resource.data.narrativeText is string
        && request.resource.data.narrativeText.size() <= 5000
        && request.resource.data.imageUrl is string
        && request.resource.data.imageUrl.size() <= 2048
        && request.resource.data.choices is list
        && request.resource.data.choices.size() <= 6
        && request.resource.data.revision is int
        && (!exists(/databases/$(database)/documents/allyStories/$(groupId))
          || request.resource.data.revision == resource.data.revision + 1)
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;

      match /votes/{uid} {
        allow get, list: if signedIn()
          && exists(/databases/$(database)/documents/allyGroups/$(groupId))
          && request.auth.uid in get(/databases/$(database)/documents/allyGroups/$(groupId)).data.members;
        allow create, update: if signedIn()
          && request.auth.uid == uid
          && exists(/databases/$(database)/documents/allyGroups/$(groupId))
          && request.auth.uid in get(/databases/$(database)/documents/allyGroups/$(groupId)).data.members
          && request.resource.data.uid == uid
          && request.resource.data.playerName is string
          && request.resource.data.playerName.size() <= 40
          && request.resource.data.choice is string
          && request.resource.data.choice.size() > 0
          && request.resource.data.choice.size() <= 100
          && request.resource.data.storyRevision is int
          && exists(/databases/$(database)/documents/allyStories/$(groupId))
          && request.resource.data.storyRevision == get(/databases/$(database)/documents/allyStories/$(groupId)).data.revision
          && get(/databases/$(database)/documents/allyStories/$(groupId)).data.choices.hasAny([request.resource.data.choice])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uid', 'playerName', 'choice', 'storyRevision', 'updatedAt'])
          && request.resource.data.updatedAt == request.time;
        allow delete: if signedIn() && request.auth.uid == uid;
      }
    }

    match /allyGroups/{groupId} {
      allow get: if signedIn() && request.auth.uid in resource.data.members;
      allow list: if false;

      allow create: if signedIn()
        && request.resource.data.leaderUid == request.auth.uid
        && request.resource.data.members == [request.auth.uid]
        && request.resource.data.memberNames is map
        && request.resource.data.memberNames.keys().hasOnly([request.auth.uid])
        && existsAfter(allyMembershipPath(request.auth.uid))
        && getAfter(allyMembershipPath(request.auth.uid)).data.groupId == groupId;

      allow update: if signedIn() && (
        // Líder remove um integrante, sem ultrapassar o limite de quatro.
        (resource.data.leaderUid == request.auth.uid
          && (!('activeBattleId' in resource.data) || resource.data.activeBattleId == '' || !exists(allyBattlePath(resource.data.activeBattleId)) || (get(allyBattlePath(resource.data.activeBattleId)).data.status == 'FINISHED' && get(allyBattlePath(resource.data.activeBattleId)).data.claimedUids.hasAll(get(allyBattlePath(resource.data.activeBattleId)).data.participantUids)))
          && request.resource.data.leaderUid == resource.data.leaderUid
          && request.resource.data.members is list
          && request.resource.data.members.size() <= 4
          && request.resource.data.members.size() == resource.data.members.size() - 1
          && resource.data.members.hasAll(request.resource.data.members)
          && request.resource.data.members.hasAny([request.auth.uid])
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberNames', 'updatedAt']))
        ||
        // Jogador convidado aceita convite válido e entra no mesmo grupo.
        (request.resource.data.leaderUid == resource.data.leaderUid
          && request.resource.data.members is list
          && request.resource.data.members.size() <= 4
          && request.resource.data.members.size() == resource.data.members.size() + 1
          && request.resource.data.members.hasAll(resource.data.members)
          && request.auth.uid in request.resource.data.members
          && !(request.auth.uid in resource.data.members)
          && request.resource.data.lastInviteId is string
          && getAfter(allyInvitePath(request.resource.data.lastInviteId)).data.receiverUid == request.auth.uid
          && getAfter(allyInvitePath(request.resource.data.lastInviteId)).data.groupId == groupId
          && getAfter(allyInvitePath(request.resource.data.lastInviteId)).data.status == 'ACCEPTED'
          && existsAfter(allyMembershipPath(request.auth.uid))
          && getAfter(allyMembershipPath(request.auth.uid)).data.groupId == groupId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberNames', 'lastInviteId', 'updatedAt']))
        ||
        // Um integrante pode sair por conta própria.
        (request.auth.uid in resource.data.members
          && request.auth.uid != resource.data.leaderUid
          && (!('activeBattleId' in resource.data) || resource.data.activeBattleId == '' || !exists(allyBattlePath(resource.data.activeBattleId)) || (get(allyBattlePath(resource.data.activeBattleId)).data.status == 'FINISHED' && get(allyBattlePath(resource.data.activeBattleId)).data.claimedUids.hasAll(get(allyBattlePath(resource.data.activeBattleId)).data.participantUids)))
          && request.resource.data.members is list
          && request.resource.data.members.size() == resource.data.members.size() - 1
          && resource.data.members.hasAll(request.resource.data.members)
          && !(request.auth.uid in request.resource.data.members)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberNames', 'updatedAt'])
          && !existsAfter(allyMembershipPath(request.auth.uid)))
        ||
        // Um integrante inicia uma batalha única para o grupo ou limpa a referência após a vitória/derrota.
        (request.auth.uid in resource.data.members
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['activeBattleId', 'updatedAt'])
          && ((request.resource.data.activeBattleId is string
              && (!('activeBattleId' in resource.data) || resource.data.activeBattleId == '' || !exists(allyBattlePath(resource.data.activeBattleId)) || (get(allyBattlePath(resource.data.activeBattleId)).data.status == 'FINISHED' && get(allyBattlePath(resource.data.activeBattleId)).data.claimedUids.hasAll(get(allyBattlePath(resource.data.activeBattleId)).data.participantUids)))
              && existsAfter(allyBattlePath(request.resource.data.activeBattleId))
              && getAfter(allyBattlePath(request.resource.data.activeBattleId)).data.groupId == groupId
              && getAfter(allyBattlePath(request.resource.data.activeBattleId)).data.starterUid == request.auth.uid
              && getAfter(allyBattlePath(request.resource.data.activeBattleId)).data.status == 'ACTIVE')
            || (request.resource.data.activeBattleId == ''
              && resource.data.activeBattleId is string
              && existsAfter(allyBattlePath(resource.data.activeBattleId))
              && getAfter(allyBattlePath(resource.data.activeBattleId)).data.status == 'FINISHED')))
      );

      allow delete: if signedIn() && resource.data.leaderUid == request.auth.uid;
    }

    match /allyBattles/{battleId} {
      allow get: if signedIn()
        && exists(allyGroupPath(resource.data.groupId))
        && request.auth.uid in get(allyGroupPath(resource.data.groupId)).data.members;
      allow list: if false;

      allow create: if signedIn()
        && request.resource.data.starterUid == request.auth.uid
        && request.resource.data.status == 'ACTIVE'
        && request.resource.data.claimedUids is list
        && request.resource.data.claimedUids.size() == 0
        && request.resource.data.participantUids is list
        && request.resource.data.participantUids.size() > 0
        && request.resource.data.participantUids.size() <= 4
        && request.resource.data.participantUids.hasAny([request.auth.uid])
        && request.resource.data.members is list
        && request.resource.data.members.size() == request.resource.data.participantUids.size()
        && request.resource.data.activePlayerUid == request.auth.uid
        && request.resource.data.revision == 0
        && request.resource.data.updatedAt == request.time
        && exists(allyGroupPath(request.resource.data.groupId))
        && request.auth.uid in get(allyGroupPath(request.resource.data.groupId)).data.members
        && get(allyGroupPath(request.resource.data.groupId)).data.members.hasAll(request.resource.data.participantUids)
        && get(/databases/$(database)/documents/worldPresence/$(request.auth.uid)).data.online == true
        && get(/databases/$(database)/documents/worldPresence/$(request.auth.uid)).data.worldPointId == request.resource.data.worldPointId
        && get(/databases/$(database)/documents/worldPresence/$(request.auth.uid)).data.ultimaAtualizacao is timestamp
        && get(/databases/$(database)/documents/worldPresence/$(request.auth.uid)).data.ultimaAtualizacao >= request.time - duration.value(30, 's')
        && get(/databases/$(database)/documents/worldPresence/$(request.auth.uid)).data.ultimaAtualizacao <= request.time;

      allow update: if signedIn()
        && exists(allyGroupPath(resource.data.groupId))
        && request.auth.uid in get(allyGroupPath(resource.data.groupId)).data.members
        && get(allyGroupPath(resource.data.groupId)).data.activeBattleId == battleId
        && (
          // Apenas o jogador do turno atual envia a próxima ação.
          (resource.data.status == 'ACTIVE'
            && resource.data.activePlayerUid == request.auth.uid
            && request.resource.data.participantUids == resource.data.participantUids
            && request.resource.data.members is list
            && request.resource.data.members.size() == resource.data.members.size()
            && request.resource.data.state is map
            && request.resource.data.activePlayerUid in resource.data.participantUids
            && request.resource.data.status in ['ACTIVE', 'FINISHED']
            && request.resource.data.revision == resource.data.revision + 1
            && request.resource.data.updatedAt == request.time
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'members', 'state', 'activePlayerUid', 'status', 'revision', 'updatedAt'
            ]))
          ||
          // Cada participante pode registrar a própria retirada de recompensa uma única vez.
          (resource.data.status == 'FINISHED'
            && request.auth.uid in resource.data.participantUids
            && !(request.auth.uid in resource.data.claimedUids)
            && request.resource.data.claimedUids is list
            && request.resource.data.claimedUids.size() == resource.data.claimedUids.size() + 1
            && request.resource.data.claimedUids.hasAll(resource.data.claimedUids)
            && request.auth.uid in request.resource.data.claimedUids
            && request.resource.data.updatedAt == request.time
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claimedUids', 'updatedAt']))
          ||
          // Aliado do mesmo grupo pode entrar quando estiver na mesma área.
          (resource.data.status == 'ACTIVE'
            && !(request.auth.uid in resource.data.participantUids)
            && request.auth.uid in request.resource.data.participantUids
            && request.resource.data.participantUids.size() == resource.data.participantUids.size() + 1
            && request.resource.data.participantUids.size() <= 4
            && request.resource.data.participantUids.hasAll(resource.data.participantUids)
            && request.resource.data.members is list
            && request.resource.data.members.size() == resource.data.members.size() + 1
            && request.resource.data.activePlayerUid == resource.data.activePlayerUid
            && request.resource.data.state == resource.data.state
            && request.resource.data.status == resource.data.status
            && request.resource.data.revision == resource.data.revision + 1
            && request.resource.data.updatedAt == request.time
            && get(/databases/$(database)/documents/worldPresence/$(request.auth.uid)).data.worldPointId == resource.data.worldPointId
            && get(/databases/$(database)/documents/worldPresence/$(request.auth.uid)).data.online == true
            && get(/databases/$(database)/documents/worldPresence/$(request.auth.uid)).data.ultimaAtualizacao is timestamp
            && get(/databases/$(database)/documents/worldPresence/$(request.auth.uid)).data.ultimaAtualizacao >= request.time - duration.value(30, 's')
        && get(/databases/$(database)/documents/worldPresence/$(request.auth.uid)).data.ultimaAtualizacao <= request.time
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'participantUids', 'revision', 'updatedAt']))
          ||
          // Recuperação cooperativa: após 60 segundos sem atualização,
          // qualquer participante pode avançar a batalha travada.
          (resource.data.status == 'ACTIVE'
            && request.auth.uid in resource.data.participantUids
            && resource.data.updatedAt is timestamp
            && request.time > resource.data.updatedAt + duration.value(60, 's')
            && request.resource.data.participantUids == resource.data.participantUids
            && request.resource.data.members is list
            && request.resource.data.members.size() == resource.data.members.size()
            && request.resource.data.state is map
            && request.resource.data.activePlayerUid in resource.data.participantUids
            && request.resource.data.status in ['ACTIVE', 'FINISHED']
            && request.resource.data.revision == resource.data.revision + 1
            && request.resource.data.updatedAt == request.time
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'members', 'state', 'activePlayerUid', 'status', 'revision', 'updatedAt'
            ]))
        );
      allow delete: if false;
    }

    match /allyMembership/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list: if false;
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['groupId'])
        && request.resource.data.groupId is string
        && existsAfter(allyGroupPath(request.resource.data.groupId))
        && uid in getAfter(allyGroupPath(request.resource.data.groupId)).data.members;
      allow update: if false;
      allow delete: if signedIn() && (
        request.auth.uid == uid
        || (resource.data.groupId is string
          && exists(allyGroupPath(resource.data.groupId))
          && get(allyGroupPath(resource.data.groupId)).data.leaderUid == request.auth.uid)
      );
    }

    match /allyInvites/{inviteId} {
      allow get, list: if signedIn() &&
        (resource.data.receiverUid == request.auth.uid || resource.data.senderUid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.senderUid == request.auth.uid
        && request.resource.data.receiverUid is string
        && request.resource.data.receiverUid != request.auth.uid
        && request.resource.data.groupId is string
        && request.resource.data.status == 'PENDING'
        && existsAfter(allyGroupPath(request.resource.data.groupId))
        && getAfter(allyGroupPath(request.resource.data.groupId)).data.leaderUid == request.auth.uid
        && request.auth.uid in getAfter(allyGroupPath(request.resource.data.groupId)).data.members
        && !exists(allyMembershipPath(request.resource.data.receiverUid));
      allow update: if signedIn()
        && resource.data.receiverUid == request.auth.uid
        && resource.data.status == 'PENDING'
        && request.resource.data.status in ['ACCEPTED', 'DECLINED']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'answeredAt'])
        && (request.resource.data.status == 'DECLINED'
          || (existsAfter(allyGroupPath(resource.data.groupId))
            && request.auth.uid in getAfter(allyGroupPath(resource.data.groupId)).data.members));
      allow delete: if false;
    }

    // Trocas: somente participantes podem consultar; gravações são exclusivas da Cloud Function.
    match /trades/{tradeId} {
      allow get, list: if signedIn()
        && (request.auth.uid == resource.data.remetenteUid
          || request.auth.uid == resource.data.destinatarioUid);
      allow create, update, delete: if false;
    }

    // Guildas: leitura somente para membros; toda alteração é validada pela Cloud Function.
    match /guilds/{guildId} {
      allow get: if signedIn() && request.auth.uid in resource.data.members;
      allow list, create, update, delete: if false;
    }

    match /guildMembership/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }

    // Catálogo global: qualquer jogador autenticado pode consultar.
    // A primeira conta que registra a criatura fica identificada no documento.
    // Depois da criação, o registro é imutável para evitar sobrescrita do catálogo.
    match /criaturas/{id} {
      function validCreatureDocument() {
        return request.resource.data.keys().hasOnly([
            'id', 'nome', 'descricao', 'rank', 'nivel',
            'vidaMaxima', 'ataque', 'defesa', 'manaMaxima',
            'agilidade', 'poderMagico', 'experienciaBase', 'perigo',
            'ecosystemId', 'bioma', 'habitat', 'raridade',
            'atividadeNoturna', 'imagemId', 'imagemIconeCaminho',
            'imagemDetalhadaCaminho', 'habilidades', 'ataques', 'drops',
            'chefe', 'criadoPorUid', 'versao'
          ])
          && request.resource.data.keys().hasAll([
            'id', 'nome', 'descricao', 'rank', 'nivel',
            'vidaMaxima', 'ataque', 'defesa', 'manaMaxima',
            'agilidade', 'poderMagico', 'experienciaBase', 'perigo',
            'ecosystemId', 'bioma', 'habitat', 'raridade',
            'atividadeNoturna', 'imagemId', 'imagemIconeCaminho',
            'imagemDetalhadaCaminho', 'habilidades', 'ataques', 'drops',
            'chefe', 'criadoPorUid', 'versao'
          ])
          && request.resource.data.id == id
          && request.resource.data.criadoPorUid == request.auth.uid
          && request.resource.data.nome is string
          && request.resource.data.nome.size() > 0
          && request.resource.data.nome.size() <= 80
          && request.resource.data.descricao is string
          && request.resource.data.descricao.size() <= 1200
          && request.resource.data.rank in ['E', 'D', 'C', 'B', 'A', 'S', 'SS', 'SSS']
          && request.resource.data.raridade in ['COMUM', 'INCOMUM', 'RARO', 'ÉPICO', 'LENDÁRIO', 'MÍTICO', 'MUNDO']
          && request.resource.data.nivel is int
          && request.resource.data.nivel >= 1
          && request.resource.data.nivel <= 10000
          && request.resource.data.vidaMaxima is int
          && request.resource.data.vidaMaxima >= 1
          && request.resource.data.vidaMaxima <= 1000000
          && request.resource.data.ataque is int
          && request.resource.data.ataque >= 0
          && request.resource.data.ataque <= 1000000
          && request.resource.data.defesa is int
          && request.resource.data.defesa >= 0
          && request.resource.data.defesa <= 1000000
          && request.resource.data.manaMaxima is int
          && request.resource.data.manaMaxima >= 0
          && request.resource.data.manaMaxima <= 1000000
          && request.resource.data.agilidade is int
          && request.resource.data.agilidade >= 0
          && request.resource.data.agilidade <= 1000000
          && request.resource.data.poderMagico is int
          && request.resource.data.poderMagico >= 0
          && request.resource.data.poderMagico <= 1000000
          && request.resource.data.experienciaBase is int
          && request.resource.data.experienciaBase >= 1
          && request.resource.data.experienciaBase <= 1000000
          && request.resource.data.perigo is int
          && request.resource.data.perigo >= 0
          && request.resource.data.perigo <= 100
          && request.resource.data.ecosystemId is string
          && request.resource.data.ecosystemId.size() > 0
          && request.resource.data.ecosystemId.size() <= 100
          && request.resource.data.bioma is string
          && request.resource.data.bioma.size() <= 100
          && request.resource.data.habitat is string
          && request.resource.data.habitat.size() <= 300
          && request.resource.data.atividadeNoturna is bool
          && request.resource.data.chefe is bool
          && request.resource.data.imagemId is string
          && request.resource.data.imagemIconeCaminho is string
          && request.resource.data.imagemDetalhadaCaminho is string
          && request.resource.data.habilidades is list
          && request.resource.data.habilidades.size() >= 1
          && request.resource.data.habilidades.size() <= 8
          && request.resource.data.ataques is list
          && request.resource.data.ataques.size() >= 1
          && request.resource.data.ataques.size() <= 6
          && request.resource.data.drops is list
          && request.resource.data.drops.size() <= 8
          && request.resource.data.versao is int
          && request.resource.data.versao == 1;
      }

      allow read: if signedIn();
      allow create: if signedIn() && validCreatureDocument();
      allow update, delete: if false;

      // A primeira arte oficial também é imutável e vinculada ao criador original.
      match /imagens/{imagemId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly([
            'criaturaId', 'imagemId', 'criadoPorUid', 'objectKey',
            'imageUrl', 'sizeBytes', 'custoRealBRL', 'criadaEm'
          ])
          && request.resource.data.keys().hasAll([
            'criaturaId', 'imagemId', 'criadoPorUid', 'objectKey',
            'imageUrl', 'sizeBytes', 'custoRealBRL', 'criadaEm'
          ])
          && request.resource.data.criadoPorUid == request.auth.uid
          && request.resource.data.criaturaId == id
          && request.resource.data.imagemId == imagemId
          && request.resource.data.objectKey == 'criaturas/' + id + '.png'
          && request.resource.data.imageUrl is string
          && request.resource.data.imageUrl.size() <= 2048
          && request.resource.data.sizeBytes is int
          && request.resource.data.sizeBytes > 0
          && request.resource.data.sizeBytes <= 5000000
          && request.resource.data.custoRealBRL is number
          && request.resource.data.custoRealBRL >= 0
          && request.resource.data.criadaEm is int
          && exists(/databases/$(database)/documents/criaturas/$(id))
          && get(/databases/$(database)/documents/criaturas/$(id)).data.criadoPorUid == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // Conteúdo multiplayer expandido. O cliente consulta apenas dados permitidos;
    // sessões, resultados, classificações e recompensas são escritos exclusivamente pelo servidor.
    match /dungeons/{dungeonId} {
      allow get: if signedIn() && request.auth.uid in resource.data.members;
      allow list, create, update, delete: if false;
    }
    match /dungeonMembership/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }
    match /worldBosses/{bossId} {
      allow read: if signedIn();
      allow write: if false;
    }
    match /arenaQueue/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }
    match /arenaMatches/{matchId} {
      allow get: if signedIn() && request.auth.uid in resource.data.participants;
      allow list, create, update, delete: if false;
    }
    match /arenaRatings/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }
    match /leaderboards/{categoria}/entries/{uid} {
      allow read: if signedIn();
      allow write: if false;
    }
    match /seasonalEvents/{seasonId} {
      allow get: if signedIn();
      allow list, create, update, delete: if false;
      match /players/{uid} {
        allow get: if signedIn() && request.auth.uid == uid;
        allow list, create, update, delete: if false;
      }
    }

    // Bestiário individual: o jogador só pode criar e consultar as próprias descobertas.
    match /jogadores/{uid}/bestiario/{criaturaId} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['criaturaId', 'nome', 'dataDescoberta'])
        && request.resource.data.keys().hasAll(['criaturaId', 'nome', 'dataDescoberta'])
        && request.resource.data.criaturaId == criaturaId
        && request.resource.data.nome is string
        && request.resource.data.nome.size() > 0
        && request.resource.data.nome.size() <= 80
        && request.resource.data.dataDescoberta is int
        && request.resource.data.dataDescoberta > 0
        && exists(/databases/$(database)/documents/criaturas/$(criaturaId))
        && request.resource.data.nome == get(/databases/$(database)/documents/criaturas/$(criaturaId)).data.nome;
      allow update, delete: if false;
    }
  }
}
