rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Dados particulares de cada jogador
    match /users/{uid} {
      allow read, create, update:
        if signedIn() && request.auth.uid == uid;
    }

    // Personagens e inventários
    match /characters/{characterId} {
      allow read:
        if signedIn() &&
        resource.data.ownerUid == request.auth.uid;

      allow create:
        if signedIn() &&
        request.resource.data.ownerUid == request.auth.uid;

      allow update:
        if signedIn() &&
        resource.data.ownerUid == request.auth.uid &&
        request.resource.data.ownerUid == request.auth.uid;

      allow delete:
        if signedIn() &&
        resource.data.ownerUid == request.auth.uid;
    }

    // Imagens e dados visuais privados de cada personagem.
    match /characterVisuals/{characterId} {
      allow read:
        if signedIn() &&
        resource.data.ownerUid == request.auth.uid;

      allow create:
        if signedIn() &&
        request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.characterId == characterId &&
        exists(/databases/$(database)/documents/characters/$(characterId)) &&
        get(/databases/$(database)/documents/characters/$(characterId)).data.ownerUid == request.auth.uid;

      allow update:
        if signedIn() &&
        resource.data.ownerUid == request.auth.uid &&
        request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.characterId == characterId &&
        exists(/databases/$(database)/documents/characters/$(characterId)) &&
        get(/databases/$(database)/documents/characters/$(characterId)).data.ownerUid == request.auth.uid;

      allow delete:
        if signedIn() &&
        resource.data.ownerUid == request.auth.uid;
    }

    // Convites são consultados diretamente pelo código; listagem é proibida.
    function invitePath(code) {
      return /databases/$(database)/documents/campaignInvites/$(code);
    }

    function joinProofPath(code, uid) {
      return /databases/$(database)/documents/campaignInvites/$(code)/joins/$(uid);
    }

    function validCampaignJoin(campaignId, code, uid) {
      return existsAfter(joinProofPath(code, uid))
        && getAfter(joinProofPath(code, uid)).data.userUid == uid
        && getAfter(joinProofPath(code, uid)).data.campaignId == campaignId
        && getAfter(joinProofPath(code, uid)).data.inviteCode == code
        && exists(invitePath(code))
        && get(invitePath(code)).data.active == true
        && get(invitePath(code)).data.campaignId == campaignId;
    }

    match /campaigns/{id} {
      allow get: if signedIn() && request.auth.uid in resource.data.members;
      allow list: if false;

      // A campanha e o convite precisam ser criados na mesma operação atômica.
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.members == [request.auth.uid]
        && request.resource.data.inviteCode is string
        && existsAfter(invitePath(request.resource.data.inviteCode))
        && getAfter(invitePath(request.resource.data.inviteCode)).data.campaignId == id
        && getAfter(invitePath(request.resource.data.inviteCode)).data.ownerUid == request.auth.uid
        && getAfter(invitePath(request.resource.data.inviteCode)).data.active == true;

      allow update: if signedIn() && (
        // O proprietário só pode editar nome e visibilidade.
        (resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'visibility']))
        ||
        // Um novo membro só pode ser adicionado com comprovante do convite.
        (request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.inviteCode == resource.data.inviteCode
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
          && resource.data.members is list
          && request.resource.data.members is list
          && request.resource.data.members.hasAll(resource.data.members)
          && request.resource.data.members.size() == resource.data.members.size() + 1
          && request.auth.uid in request.resource.data.members
          && validCampaignJoin(id, resource.data.inviteCode, request.auth.uid))
      );

      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    match /campaignInvites/{code} {
      allow get: if signedIn() && resource.data.active == true;
      allow list: if false;

      // O convite só pode nascer junto da campanha correspondente.
      allow create: if signedIn()
        && request.resource.data.inviteCode == code
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.active == true
        && request.resource.data.campaignId is string
        && existsAfter(/databases/$(database)/documents/campaigns/$(request.resource.data.campaignId))
        && getAfter(/databases/$(database)/documents/campaigns/$(request.resource.data.campaignId)).data.ownerUid == request.auth.uid
        && getAfter(/databases/$(database)/documents/campaigns/$(request.resource.data.campaignId)).data.inviteCode == code;

      allow update, delete: if false;

      match /joins/{uid} {
        allow read: if false;
        allow create: if signedIn()
          && request.auth.uid == uid
          && request.resource.data.userUid == uid
          && request.resource.data.inviteCode == code
          && request.resource.data.campaignId is string
          && exists(invitePath(code))
          && get(invitePath(code)).data.active == true
          && get(invitePath(code)).data.campaignId == request.resource.data.campaignId
          && exists(/databases/$(database)/documents/campaigns/$(request.resource.data.campaignId))
          && !(uid in get(/databases/$(database)/documents/campaigns/$(request.resource.data.campaignId)).data.members)
          && existsAfter(/databases/$(database)/documents/campaigns/$(request.resource.data.campaignId))
          && uid in getAfter(/databases/$(database)/documents/campaigns/$(request.resource.data.campaignId)).data.members;
        allow update, delete: if false;
      }
    }

    // Catálogo global: qualquer jogador autenticado pode consultar.
    match /criaturas/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.id == id
        && request.resource.data.criadoPorUid == request.auth.uid
        && request.resource.data.nome is string
        && request.resource.data.nome.size() > 0
        && request.resource.data.ecosystemId is string
        && request.resource.data.ecosystemId.size() > 0;
      allow update, delete: if false;

      // Metadados das artes: somente o primeiro registrador pode criar.
      match /imagens/{imagemId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.criadoPorUid == request.auth.uid
          && request.resource.data.criaturaId == id
          && request.resource.data.imagemId == imagemId
          && exists(/databases/$(database)/documents/criaturas/$(id))
          && get(/databases/$(database)/documents/criaturas/$(id)).data.criadoPorUid == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // Bestiário individual — descobertas privadas de cada jogador
    match /jogadores/{uid}/bestiario/{criaturaId} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.criaturaId == criaturaId
        && exists(/databases/$(database)/documents/criaturas/$(criaturaId));
      allow update, delete: if false;
    }
  }
}
